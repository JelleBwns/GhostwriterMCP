  {
    "name": "gw_create_finding",
    "title": null,
    "description": "Create a finding directly in the external Ghostwriter report.\n\nWrites immediately with your Ghostwriter identity. Supply plain-text content\ndrafted by the calling agent, and a finding_type_id from gw_get_finding_options\nunless a default is configured. Do not invent evidence, exploitation or CVSS.\nOptional sections may be left empty for further drafting. Saved complete=false\nfor Ghostwriter QA. Reuses identical content when found. No local services or\nseparate approval workflow are involved.",
    "inputSchema": {
      "properties": {
        "project_id": {
          "type": "integer"
        },
        "report_id": {
          "type": "integer"
        },
        "finding": {
          "description": "Plain-text report content supplied by the calling agent; never generated server-side.",
          "properties": {
            "title": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            "severity": {
              "enum": [
                "critical",
                "high",
                "medium",
                "low",
                "info"
              ],
              "type": "string"
            },
            "description": {
              "maxLength": 100000,
              "minLength": 1,
              "type": "string"
            },
            "impact": {
              "default": "",
              "maxLength": 100000,
              "type": "string"
            },
            "remediation": {
              "default": "",
              "maxLength": 100000,
              "type": "string"
            },
            "reproduction": {
              "default": "",
              "maxLength": 100000,
              "type": "string"
            },
            "affected_entities": {
              "items": {
                "type": "string"
              },
              "maxItems": 1000,
              "type": "array"
            },
            "references": {
              "items": {
                "type": "string"
              },
              "maxItems": 100,
              "type": "array"
            },
            "finding_type_id": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "cvss_score": {
              "anyOf": [
                {
                  "maximum": 10,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "cvss_vector": {
              "anyOf": [
                {
                  "maxLength": 512,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            }
          },
          "required": [
            "title",
            "severity",
            "description"
          ],
          "type": "object"
        }
      },
      "required": [
        "project_id",
        "report_id",
        "finding"
      ],
      "type": "object"
    },
    "outputSchema": {
      "properties": {
        "ok": {
          "default": true,
          "type": "boolean"
        },
        "data": {
          "default": null,
          "title": "Data"
        },
        "error": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "type": "object"
    },
    "icons": null,
    "annotations": {
      "title": null,
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": null,
      "openWorldHint": null
    },
    "meta": {
      "_fastmcp": {
        "tags": [
          "findings"
        ]
      }
    },
    "execution": null
  },

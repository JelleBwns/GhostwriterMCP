GW_BASE_URL=https://ghostwriter.example.org
GW_TOKEN=
GW_TLS_VERIFY=true
# Scope restrictions are optional. Nonempty lists intersect when both are configured.
# Missing/empty lists add no restriction at that level.
# Replace with your project IDs to restrict access; empty means no project filter.
ALLOWED_PROJECTS=[]
ALLOWED_CLIENTS=[]
# Tool allowlist / blacklist. Exact names only; the blacklist wins on overlaps.
# Missing/empty tool lists mean all 23 reporting tools are enabled.
GW_ENABLED_TOOLS=[]
GW_DISABLED_TOOLS=[]
# Allowlist example:
# GW_ENABLED_TOOLS=["gw_list_projects","gw_get_project","gw_list_reports","gw_get_report","gw_list_findings","gw_get_finding_options","gw_create_finding"]
# Blacklist-only example (leave GW_ENABLED_TOOLS empty or absent):
# GW_DISABLED_TOOLS=["gw_create_report","gw_delete_finding","gw_delete_evidence"]
# Client-only scope example (leave ALLOWED_PROJECTS empty or absent):
# ALLOWED_CLIENTS=[7]
# Optional settings:
# FINDING_TYPE_ID=1
# GW_SUMMARY_FIELD=existing_report_summary_field
GW_MAX_FILE_BYTES=20971520
